时间尺度 1纳秒 / 1皮秒
//  功能描述:	波特率控制器模块
//				- 根据按键输入切换UART通信波特率
//				- 支持4800/9600/115200三种波特率
//------------------------------------------------------------------------------
//  按键映射:
//  ┌────────┬──────────┬────────────┐
//  │ 按键   │ Baud_Set │ 波特率     │
//  ├────────┼──────────┼────────────┤
//  │ KEY0   │   00     │ 4800       │
//  │ KEY1   │   01     │ 9600       │
//  │ KEY2   │   10     │ 115200     │
//  └────────┴──────────┴────────────┘
//  注意: 按键按下为低电平(0)，未按下为高电平(1)
//------------------------------------------------------------------------------
//******************************************************************************

模块 波特率控制器(
	//==========================================================================
	// 系统信号
	//==========================================================================
	输入						clk,				// 20MHz系统时钟
	输入						rst_n,				// 系统复位（低有效）
	
	//==========================================================================
	// 按键输入
	//==========================================================================
	输入			[2:0]		key_in,				// 按键输入[KEY2,KEY1,KEY0]
	
	//==========================================================================
	// 波特率选择输出
	//==========================================================================
	输出	寄存器		[1:0]		波特率选择			// 波特率选择: 00=4800, 01=9600, 10=115200
);

//==============================================================================
// 内部信号定义
//==============================================================================

reg			[2:0]			key_sync；				// 按键同步寄存器

//==============================================================================
// 按键信号同步（防止亚稳态）
//==============================================================================
always @(posedge clk or negedge rst_n) begin
	if (!rst_n)
		key_sync <= 3'b111；							// 复位时默认未按下
	else
		key_sync <= key_in;
end

//==============================================================================
// 波特率选择逻辑
//==============================================================================
always @(posedge clk or negedge rst_n) begin
	if (!rst_n) begin
		Baud_Set <= 2'd2;							// 复位默认115200
	end
	else begin
		casez (key_sync)
			3'b110：Baud_Set <= 2'd0；				// 按下KEY0 → 4800
			3'b101：Baud_Set <= 2'd1；				// 按下KEY1 → 9600
			3'b011：Baud_Set <= 2'd2；				// 按下KEY2 → 115200
			默认：Baud_Set <= Baud_Set;			// 保持原值
		endcase
	end
end

endmodule
